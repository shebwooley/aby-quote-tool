#!/bin/sh
# Refuse a commit that breaks a page the worker emits.
#
# 🔴 WHY THIS EXISTS: every admin page in worker.js is built from a TEMPLATE LITERAL, and two
# ordinary-looking edits silently destroy one:
#   * a BACKTICK anywhere inside it -- including in a // comment -- ends the literal early;
#   * a lone BACKSLASH is eaten, so \d and \s reach the browser as the bare letters d and s.
# Both leave worker.js as VALID JavaScript, so `node --check` passes and the page is broken. That
# trap landed six times in a single day on 2026-08-19, every time because the page check was a
# separate command somebody had to remember.
#
# ⭐ A rule with no checker is a preference; a checker you have to remember to run is a preference
# with extra steps. This makes it automatic.
#
# Enable it once per clone:   git config core.hooksPath .githooks
# Bypass in a genuine emergency:   git commit --no-verify

if git diff --cached --name-only | grep -q '^worker\.js$'; then
  echo "worker.js changed - checking every page it emits..."

  if ! node --check worker.js; then
    echo "worker.js is not valid JavaScript. Commit refused."
    exit 1
  fi

  # 🔴 THE AUTHORITATIVE CHECK, ADDED 2026-08-19 AFTER A REAL DEPLOY FAILURE.
  # A backtick in a comment inside ABY_INTERNAL_JS passed `node --check` AND passed the page
  # checker (which did not cover that literal at the time) and was then refused by esbuild, inside
  # wrangler, at deploy. Only the real bundler agrees with production, so ask it. ~5 seconds.
  if ! npx wrangler deploy --dry-run > /dev/null 2>&1; then
    echo ""
    echo "wrangler could not BUILD this worker, so it could not deploy either. Commit refused."
    echo "See the real error with:  npx wrangler deploy --dry-run"
    exit 1
  fi

  if ! node scripts/check_worker_pages.mjs; then
    echo ""
    echo "A page the worker emits is broken. Commit refused."
    echo "Almost always a backtick inside a template literal, or a lone backslash in a regex."
    echo "Run: node scripts/check_worker_pages.mjs"
    exit 1
  fi

  # 🔴 THE CRM SPINE BEHAVES OVER REAL HTTP, AGAINST A REAL LOCAL D1 (F-383).
  # Every check above this line reads SOURCE TEXT. That catches a broken template literal and is
  # useless against a query that is valid SQL and returns the wrong rows -- which is the defect this
  # admin has shipped again and again: a lookup routed through an empty table, a filter that matched
  # nothing, an empty result rendered as a happy state. None of them is visible without asking the
  # server what it actually returns.
  # ~18 seconds. It is in the hook rather than in the session checklist because this repo has NO CI
  # AT ALL and the deploy is a separate manual command, so the commit is the only moment anything is
  # guaranteed to run.
  if ! node scripts/check_crm.mjs; then
    echo ""
    echo "The CRM notes/tags endpoints do not behave. Commit refused."
    echo "Run: node scripts/check_crm.mjs --self-test"
    exit 1
  fi

  # The rollup BEHAVES, not just parses. The page checker above proves the JavaScript is valid;
  # this one runs the real grouping against fixtures and asserts a child never vanishes, a parent
  # count is own-plus-children, and an acquired name stays off the fallen-off list.
  # A rule with no checker is a preference; a checker with no trigger is a suggestion.
  if ! node scripts/check_agency_rollup.mjs; then
    echo ""
    echo "The agency rollup on /admin/brokers is wrong. Commit refused."
    echo "Run: node scripts/check_agency_rollup.mjs --self-test"
    exit 1
  fi
fi

# 🔴🔴 CAN A USER REACH WHAT WE BUILT? Added 2026-08-23 after F-367 -- the employer corrects the
# headcount -- was found to be built, deployed, CORRECT and unreachable for a day. It renders only
# on a shared quote link, and the only way to mint one was a button buried in an expanded row of
# the quote log. Eric: "I only see download pdf, download html, and print, not share link."
#
# ⛔ EVERY OTHER CHECK HERE ASKS "IS IT CORRECT". A pricing assertion cannot fail when the feature
# has no door -- the maths is fine and nobody can get to it. This one asks about the door.
#
# ⚠️ IT WATCHES THREE FILES, NOT JUST worker.js. The share button lives in assets/js/app.js and
# depends on save-hook.js keeping the quote id; a check gated on worker.js alone would have sat
# silent through exactly the change that broke it.
if git diff --cached --name-only | grep -qE '^(worker\.js|assets/js/app\.js|save-hook\.js)$'; then
  if ! node scripts/check_reachable.mjs; then
    echo ""
    echo "Something built is unreachable from any screen a user is on. Commit refused."
    echo "Run: node scripts/check_reachable.mjs --self-test"
    exit 1
  fi
fi
