// TEST-ONLY wrangler config, for running `scripts/test_broker_auth.mjs` against a local worker.
//
// ⚠️ WHY IT EXISTS. The real config sets `assets.directory: "."`, so `wrangler dev` watches the
// WHOLE REPO -- including the `.wrangler/state` it writes to itself. That is a reload loop: the
// server rebuilds continuously and every request hangs, which reads exactly like a broken
// worker. Dropping the assets binding breaks the loop.
//
// ⛔ NOT A DEPLOY CONFIG. `env.ASSETS` is absent here, so the routes that serve the quoting tool
// itself will not work under it. The API routes, `/dashboard` and `/set-password` do not touch
// ASSETS, which is exactly the surface the auth test exercises.
//
//   npx wrangler dev -c wrangler.test.jsonc --local --port 8787
//   node scripts/test_broker_auth.mjs
{
  "name": "aby-quote-tool-test",
  "compatibility_date": "2026-05-08",
  "main": "worker.js",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aby-quotes",
      "database_id": "72b0d610-c55f-4b56-af26-613ab047b592"
    }
  ]
}
